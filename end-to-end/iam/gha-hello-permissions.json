{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EcrLogin",
            "Effect": "Allow",
            "Action": "ecr:GetAuthorizationToken",
            "Resource": "*"
        },
        {
            "Sid": "PushHelloWebOnly",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:InitiateLayerUpload",
                "ecr:UploadLayerPart",
                "ecr:CompleteLayerUpload",
                "ecr:PutImage"
            ],
            "Resource": "arn:aws:ecr:us-east-1:<ACCOUNT_ID>:repository/hello-web"
        },
        {
            "Sid": "FindTheInstance",
            "Effect": "Allow",
            "Action": "ec2:DescribeInstances",
            "Resource": "*"
        },
        {
            "Sid": "RunCommandOnHelloInstancesOnly",
            "Effect": "Allow",
            "Action": "ssm:SendCommand",
            "Resource": "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:instance/*",
            "Condition": {
                "StringEquals": {
                    "ssm:resourceTag/App": "hello-web"
                }
            }
        },
        {
            "Sid": "OnlyTheShellScriptDocument",
            "Effect": "Allow",
            "Action": "ssm:SendCommand",
            "Resource": "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
        },
        {
            "Sid": "ReadCommandResults",
            "Effect": "Allow",
            "Action": [
                "ssm:GetCommandInvocation",
                "ssm:ListCommandInvocations"
            ],
            "Resource": "*"
        }
    ]
}
